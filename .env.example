# ================================
# AltStore/Playstore Platform
# Environment Configuration
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real values to version control

# ================================
# API Configuration
# ================================
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000

# ================================
# GitHub API Configuration
# ================================
# Generate token at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=

# GitHub API request timeout in seconds
GITHUB_API_TIMEOUT=30

# ================================
# Rate Limiting
# ================================
# Format: {requests}/{period} (e.g., 100/minute, 1000/hour)
RATE_LIMIT_SEARCH=100/minute
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_INSTALL=10/minute

# ================================
# Storage Configuration
# ================================
# Main storage directory (must be within project directory)
ALTSTORE_STORAGE=./altstore_storage

# Workflow persistence directory
WORKFLOW_STORAGE=./data/workflows

# Capsule storage directory
CAPSULE_STORAGE=./altstore_storage/capsules

# Installation directory
INSTALLATION_STORAGE=./altstore_storage/installations

# ================================
# Security Configuration
# ================================
# CRITICAL: Generate secure random keys for production
# Use: openssl rand -hex 32
MASTER_KEY=
SECRET_KEY=

# JWT token expiration
JWT_EXPIRATION_HOURS=24

# Session timeout in seconds
SESSION_TIMEOUT=3600

# ================================
# Cryptography
# ================================
# Set to 'true' to require cryptography library (RECOMMENDED)
# Set to 'false' to allow mock cryptography (INSECURE, dev only)
CRYPTOGRAPHY_REQUIRED=true

# ================================
# Timeouts
# ================================
# Build operation timeout in seconds
BUILD_TIMEOUT=300

# Installation timeout in seconds
INSTALL_TIMEOUT=600

# WASM execution timeout in seconds
WASM_TIMEOUT=30

# Docker build timeout in seconds
DOCKER_TIMEOUT=600

# ================================
# Feature Flags
# ================================
# Enable WASM fallback for incompatible applications
ENABLE_WASM_FALLBACK=true

# Enable offline capsule creation and distribution
ENABLE_OFFLINE_CAPSULES=true

# Enable federated index synchronization
ENABLE_FEDERATED_INDEX=false

# Enable GitHub integration
ENABLE_GITHUB_INTEGRATION=true

# Enable formal verification (requires Z3)
ENABLE_FORMAL_VERIFICATION=true

# Enable reproducible builds
ENABLE_REPRODUCIBLE_BUILDS=true

# ================================
# Frontend Configuration
# ================================
# Public API URL for frontend (must be accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend build mode (development/production)
NEXT_PUBLIC_BUILD_MODE=development

# ================================
# Logging Configuration
# ================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=text

# Log file path (empty for stdout only)
LOG_FILE=

# ================================
# Database Configuration (Optional)
# ================================
# For production workflow persistence
# DATABASE_URL=postgresql://user:password@localhost:5432/altstore

# Redis URL for caching and rate limiting
# REDIS_URL=redis://localhost:6379/0

# ================================
# Monitoring Configuration (Optional)
# ================================
# Sentry DSN for error tracking
# SENTRY_DSN=

# Prometheus metrics endpoint
# ENABLE_PROMETHEUS=false
# PROMETHEUS_PORT=9090

# ================================
# Development Only
# ================================
# Enable hot reload
DEV_RELOAD=true

# Enable debug mode (DO NOT use in production)
DEBUG=false

# Enable test mode
TEST_MODE=false
